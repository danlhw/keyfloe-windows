{
  "name": "keyfloe-windows",
  "productName": "Keyfloe",
  "version": "0.1.4",
  "description": "Keyfloe for Windows — native AI companion. Voice in, text out. Right-Ctrl opens a chat pill anchored to the cursor; hold Right-Ctrl to dictate; Interview mode for live call transcription + answer suggestions; Clicky cursor pointer mode for screen-grounded help.",
  "author": "Onefloe",
  "license": "UNLICENSED",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently -k -n MAIN,REND \"npm:dev:main\" \"npm:dev:renderer\"",
    "dev:main": "tsc -p tsconfig.main.json -w & vite build -c vite.main.config.ts --watch",
    "dev:renderer": "vite",
    "build:main": "tsc -p tsconfig.main.json && vite build -c vite.main.config.ts",
    "build:preload": "vite build -c vite.preload.config.ts",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "start": "electron .",
    "package": "npm run build && electron-builder --win --x64",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.0",
    "electron-store": "^8.2.0",
    "node-fetch": "^3.3.2",
    "uiohook-napi": "^1.5.4",
    "uuid": "^11.0.3",
    "wav-decoder": "^1.3.0",
    "wav-encoder": "^1.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.onefloe.keyfloe",
    "productName": "Keyfloe",
    "copyright": "Copyright © 2026 Onefloe",
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "nodeGypRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/whisper-models",
        "to": "whisper-models",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "legalTrademarks": "Keyfloe™ Onefloe",
      "signtoolOptions": {
        "publisherName": "Onefloe"
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Keyfloe"
    }
  }
}
